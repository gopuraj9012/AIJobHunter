# TailorTalent AI service configuration — copy to .env and fill in.
# Without OPENAI_API_KEY the service runs in mock mode (deterministic sample responses).
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Bind address for `python main.py` (uvicorn CLI flags take precedence when used)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
